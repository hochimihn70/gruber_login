DATABASE_URL=mysql+pymysql://authuser:authpassword@db:3306/authdb

# Cloudflare Tunnel Token
# In Cloudflare Zero Trust: Tunnel erstellen, Domain "logintest.smoothingo.com" auf "http://web:5000" routen und Token hier eintragen:
TUNNEL_TOKEN=

# E-Mail-Versand (SMTP) - Quelle: https://resend.com/docs/send-with-smtp
#
# API-Key anlegen: resend.com -> API Keys -> Create API Key (beginnt mit "re_")
# Absender-Domain muss in Resend verifiziert sein (resend.com -> Domains),
# sonst lehnt Resend die Mails ab. In Cloudflare dafür 3 DNS-Records anlegen:
#   MX   send                 -> <Wert von Resend>   (Priority 10)
#   TXT  send                 -> "v=spf1 include:amazonses.com ~all"
#   TXT  resend._domainkey    -> <DKIM-Wert von Resend>   (Proxy: DNS only!)
#
# WICHTIG: Solange SMTP_PASSWORD leer ist, läuft die App im Dev-Modus.
# Es wird dann keine E-Mail verschickt, sondern der Code direkt im Browser
# angezeigt (und zusätzlich ins Docker-Log geschrieben).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@smoothingo.com

# Session-Cookie: true = nur über HTTPS senden (Standard, für die Cloudflare-Tunnel-URL).
# Auf "false" setzen, wenn die App testweise über eine LAN-IP ohne HTTPS läuft -
# dann wäre das Cookie sonst blockiert und der Login würde nicht funktionieren.
SESSION_COOKIE_SECURE=true

# Zeitliche Login-Beschränkung (optional): erlaubt sind 06:00 bis 22:00 Uhr.
# Wird die Serverzeit des Containers geprüft (standardmäßig UTC).
LOGIN_RESTRICTION_ENABLED=false
LOGIN_ALLOWED_START_HOUR=6
LOGIN_ALLOWED_END_HOUR=22
